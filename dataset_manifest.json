{
	"dataset_meta": {
		"name": "URT-SimReal",
		"description": "A Large-Scale Multi-Frequency Hybrid Dataset for Integrated Sensing and Communication in Urban Rail Transit.",
		"version": "1.0.0",
		"maintainer": "YeJiang",
		"keywords": [
			"Urban Rail Transit",
			"Sim-and-Real",
			"Channel Modeling",
			"Multi-model Sensing",
			"Geometry-specific",
			"Channel Measurement",
			"Ray Tracing",
			"Sub-6G",
			"mmWave",
			"ISAC"
		],
		"coordinate_system": "Cartesian (ENU: East-North-Up)",
		"unit": "meter"
	},
	"data_structure_definition": {
		"root_directory": "./URT_SimReal",
		"modalities": {
			"physical_environmental_sensing": {
				"description": "Geometry and visual semantics of the environment.",
				"formats": [
					".ply (Point cloud)",
					".png (RGB Image)",
					".json (environment_semantics.json)"
				]
			},
			"wireless_channel_propagation": {
				"description": "Frequency-domain and Time-domain channel state information (CSI).",
				"formats": [
					".h5 (CIR/Params)",
					".json (channel_labels.json)"
				]
			}
		},
		"domains": {
			"Real": "Measurement-based data from physical campaigns.",
			"Sim": "Ray-tracing simulation data aligned with physical measurement configurations."
		}
	},
